"""dbt-level tests from dbt-polars. Remove a class, or override a test with
@pytest.mark.skip, when it doesn't apply to your catalog."""

from dbt.adapters.polars.testing.catalog import (
{%- for name in catalog_tests %}
    Base{{ name }},
{%- endfor %}
)
{%- if implements_data_operations %}
from dbt.adapters.polars.testing.data_operations import (
{%- for name in data_operations_tests %}
    Base{{ name }},
{%- endfor %}
)
{%- endif %}
{%- for name in catalog_tests + (data_operations_tests if implements_data_operations else []) %}


class Test{{ name }}(Base{{ name }}):
    pass
{%- endfor %}
