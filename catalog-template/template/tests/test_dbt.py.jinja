    "IncrementalNotSchemaChange", "SeedCustomSchema", "SeedParsing",
    "SeedWithExplicitCatalog", "SeedWithExplicitCatalogParsing",
    "SimpleMaterializations", "SimpleSeedEnabledViaConfig", "SimpleSeedWithBOM",
    "SnapshotCheckCols", "SnapshotTimestamp", "TableMaterialization",
] -%}
{%- set data_operations_tests = [
    "IncrementalAppend", "IncrementalDeleteInsert", "IncrementalFailOnTypeChange",
    "IncrementalFullRefresh", "IncrementalMerge", "IncrementalOnSchemaChange",
    "IncrementalOnSchemaChangeAppend", "IncrementalUniqueKey",
    "MergeColumnsMutuallyExclusive", "MergeExcludeColumns", "MergeUpdateColumns",
