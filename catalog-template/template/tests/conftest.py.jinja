            },
        ],
    }


@pytest.fixture
def catalog_under_test() -> BaseCatalog:
    return build_catalog("catalog_test", PRIMARY_CATALOG_OPTIONS)


@pytest.fixture(scope="session", autouse=True)
def cleanup_test_schemas():
    """Drop this run's test schemas, and test schemas older than 24 hours."""
    yield
    for name, options in [
        ("primary", PRIMARY_CATALOG_OPTIONS),
        ("secondary", SECONDARY_CATALOG_OPTIONS),
    ]:
        catalog = build_catalog(name, options)
        for schema in catalog.list_schemas():
            if is_removable_test_schema(schema):
                catalog.drop_schema(
                    PolarsRelation.create(database=name, schema=schema, catalog=name)
                )
