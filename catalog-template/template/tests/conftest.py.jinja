import pytest
from dbt.adapters.polars.catalogs import BaseCatalog, PolarsRelation, create_catalog
from dbt.adapters.polars.testing.mixin import is_removable_test_schema

from {{ package_name }} import (
    config_class,
)

pytest_plugins = ["dbt.adapters.polars.testing.plugin"]

# Options of two test instances of your backend (e.g. two buckets or two prefixes).
# They must not share storage: some tests check a table lands in one and not the other.
PRIMARY_CATALOG_OPTIONS: dict = {}
SECONDARY_CATALOG_OPTIONS: dict = {}


def build_catalog(name: str, options: dict) -> BaseCatalog:
    config = config_class(
        name=name,
        type="{{ catalog_name }}",
        schema="unused",
        **options,
    )
    return create_catalog(config, "")


